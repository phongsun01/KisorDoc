# KisorDoc-AI Environment Variables
# Copy file này thành .env và điền giá trị phù hợp
# .env sẽ được load tự động bởi ứng dụng, thay thế hoàn toàn Config-5.txt cũ

# === BẮT BUỘC ===

# Đường dẫn tuyệt đối đến thư mục dự án (chứa 1. Data/, 2. Templates/, 3. Files/)
PROJECT_PATH=D:\YourProjectPath

# === TÙY CHỌN (có giá trị mặc định) ===

# Chế độ online: "Enable" hoặc "Disable" (mặc định: Disable)
ONLINE_MODE=Disable

# Tên thư mục Data (mặc định: 1. Data)
DATA_FOLDER=1. Data

# Tên thư mục Templates (mặc định: 2. Templates)
TEMPLATE_FOLDER=2. Templates

# Tên thư mục Files đầu ra (mặc định: 3. Files)
FILE_FOLDER=3. Files

# Tên sheet dữ liệu gói thầu trong file Excel (mặc định: GoiThau)
DATA_SHEET=GoiThau

# Tự động đóng Word sau khi xử lý: "true" hoặc "false" (mặc định: false)
CLOSE_WORD=false

# Tên process Word trong Task Manager (mặc định: WINWORD.exe)
TASK_MANAGER_PROCESS=WINWORD.exe

# Đường dẫn đến agent (để trống nếu không dùng)
AGENT_PATH=

# Tiền tố sheet ngoại lệ (mặc định: S.)
EXCEPTION_SHEET=S.

# Tên ứng dụng hiển thị trên giao diện (mặc định: KisorDoc-AI)
APP_NAME=KisorDoc-AI